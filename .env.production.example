# =========================================================
#  Configuration — PRODUCTION (sur le serveur, avec Docker)
#  Sur le serveur :  cp .env.production.example .env   puis remplissez TOUT ce qui est entre < >.
#  Ce fichier contient des secrets : ne l'envoyez jamais par e-mail et ne le publiez pas.
# =========================================================

# ---------- Domaine ----------
# Sans "https://" ni "www." : le certificat HTTPS est créé automatiquement pour ce domaine et www.
DOMAIN=<mon-cabinet.fr>
BASE_URL=https://<mon-cabinet.fr>

# Générer avec :  openssl rand -hex 32
SESSION_SECRET=<longue-chaine-aleatoire-64-caracteres>

# ---------- Base de données (créée automatiquement par Docker) ----------
DB_NAME=kine_db
DB_USER=kine
# Générer avec :  openssl rand -hex 24   (deux valeurs différentes)
DB_PASSWORD=<mot-de-passe-base>
DB_ROOT_PASSWORD=<mot-de-passe-root-base>

# ---------- Cabinet (affiché sur le site, les e-mails et les factures) ----------
SITE_NAME=<Cabinet …>
THERAPIST_NAME=<Prénom Nom>
SITE_PHONE=<05 …>
SITE_EMAIL=<contact@mon-cabinet.fr>
SITE_ADDRESS=<N° rue, code postal Ville>
SIRET=<123 456 789 00012>
RPPS=<10…>
# Hébergeur (mentions légales obligatoires) : nom, adresse, téléphone
HOST_INFO=<Nom de l'hébergeur HDS, adresse, téléphone>

# ---------- Facturation (à valider avec votre comptable) ----------
VAT_RATE=0
VAT_NUMBER=
VAT_EXEMPT_MENTION=TVA non applicable, art. 293 B du CGI
INVOICE_PREFIX=F

# ---------- Rendez-vous ----------
SLOT_MINUTES=45
MIN_NOTICE_HOURS=2
MAX_DAYS_AHEAD=60
CANCEL_HOURS=24
REMINDERS=on
RETENTION_APPOINTMENTS_MONTHS=36

# ---------- Stripe (dashboard.stripe.com → Développeurs) ----------
# sk_test_… pour tester sur le serveur, puis sk_live_… pour encaisser réellement
STRIPE_SECRET_KEY=<sk_live_…>
# Webhook : https://<mon-cabinet.fr>/api/stripe/webhook
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired, charge.refunded
STRIPE_WEBHOOK_SECRET=<whsec_…>

# ---------- E-mails (Brevo, OVH, Gmail Workspace…) ----------
SMTP_HOST=<smtp-relay.brevo.com>
SMTP_PORT=587
SMTP_USER=<identifiant>
SMTP_PASS=<mot-de-passe-smtp>
# Expéditeur affiché, ex. : Cabinet Élan <no-reply@mon-cabinet.fr>
SMTP_FROM=<Nom du cabinet> <no-reply@mon-cabinet.fr>

# Mettre à 1 UNIQUEMENT pour une démo (insère 6 programmes d'exemple à la 1re installation)
SEED_DEMO=0
