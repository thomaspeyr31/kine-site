# =========================================================
#  Configuration — DÉVELOPPEMENT (sur votre ordinateur)
#  Copiez ce fichier en .env :  cp .env.example .env
#  Pour le serveur, utilisez plutôt .env.production.example
# =========================================================

PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
SESSION_SECRET=dev-uniquement-changez-moi-en-production-svp

# ---------- Base MySQL / MariaDB ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=kine
DB_PASSWORD=kine_pass
DB_NAME=kine_db

# ---------- Cabinet ----------
SITE_NAME=Cabinet Élan
THERAPIST_NAME=Camille Martin
SITE_PHONE=05 00 00 00 00
SITE_EMAIL=contact@exemple.fr
SITE_ADDRESS=12 rue du Mouvement, 33000 Ville
SIRET=
RPPS=
HOST_INFO=

# ---------- Facturation ----------
# Taux de TVA (%) appliqué aux programmes ; 0 = franchise en base (mention ci-dessous sur les factures)
VAT_RATE=0
VAT_NUMBER=
VAT_EXEMPT_MENTION=TVA non applicable, art. 293 B du CGI
INVOICE_PREFIX=F

# ---------- Rendez-vous ----------
SLOT_MINUTES=45
MIN_NOTICE_HOURS=2
MAX_DAYS_AHEAD=60
CANCEL_HOURS=24
REMINDERS=on
RETENTION_APPOINTMENTS_MONTHS=36

# ---------- Stripe ----------
# Vide = mode démo (achats validés sans paiement, développement uniquement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- E-mails ----------
# Vide = les e-mails sont affichés dans la console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Cabinet Élan <no-reply@exemple.fr>
